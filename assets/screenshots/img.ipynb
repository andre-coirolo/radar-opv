    "import pymupdf\n",
    "\n",
    "pdf = pymupdf.open(\"A:/Python/Github/radar-opv/assests/screenshots/Produtividade_pdf.pdf\")\n",
    "\n",
    "pagina = pdf[0]  # 0 = primeira página\n",
    "pix = pagina.get_pixmap(matrix=pymupdf.Matrix(2, 2))\n",
    "\n",
    "pix.save(\"A:/Python/Github/radar-opv/assests/screenshots/IS_Geral.png\")\n",
    "\n",
    "pdf.close()"
   ]
  }
